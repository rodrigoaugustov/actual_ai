# Copy to deploy/.env on the host and `chmod 600` it.
# Never commit the real file — deploy/.gitignore keeps it out.

# Tunnel token from Cloudflare Zero Trust > Networks > Tunnels.
# This is a credential: anyone holding it can serve traffic as your hostname.
TUNNEL_TOKEN=

# The channel update.sh watches. `master` is the moving tag published by
# .github/workflows/fork-image.yml on every push.
ACTUAL_CHANNEL_REF=ghcr.io/rodrigoaugustov/actual-ai:master

# The image actually running, pinned by digest. update.sh rewrites this line
# after every successful rollout and on rollback — you normally do not edit it
# by hand. Starts as the plain tag for the very first boot.
ACTUAL_IMAGE=ghcr.io/rodrigoaugustov/actual-ai:master

# Host path for the SQLite data. Must be owned by uid/gid 1001.
ACTUAL_DATA_DIR=/srv/actual/data

# CIDR the server trusts as a proxy, so rate limiting sees real client IPs.
# The compose bridge network lives inside 172.16.0.0/12 by default.
ACTUAL_TRUSTED_PROXIES=172.16.0.0/12

# --- backup.sh ---------------------------------------------------------------

# age public key. Only the PUBLIC key belongs on this host, which makes the
# backups write-only: a compromised server cannot read its own history.
# Keep the private key in your password manager.
AGE_RECIPIENT=

# rclone remote configured for Cloudflare R2, plus the bucket.
RCLONE_REMOTE=r2
RCLONE_BUCKET=actual-backups

# --- notifications -----------------------------------------------------------

# ntfy.sh topic for deploy and backup results (push notification on your phone).
# Pick something unguessable — topics are public to anyone who knows the name.
# Leave empty to disable notifications.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
